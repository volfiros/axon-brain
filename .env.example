# Copy to .env and fill in. .env is git-ignored.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# One graph per workspace: <prefix>_<workspace>
FALKORDB_GRAPH_PREFIX=axon

# LLM and embeddings
LLM_PROVIDER=anthropic
LLM_API_KEY=your-llm-api-key
LLM_MODEL=
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# GitHub ingestion and PR guard (fine-grained token, read-only on the demo repo)
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/repo

# Auth: generate the secret with `openssl rand -base64 32`. The URL is the public base URL of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Fallback Plane and Slack credentials for the one Workspace named here. Others connect from /w/<slug>/connectors.
CONNECTORS_WORKSPACE=demo
PLANE_API_KEY=your-plane-api-key
PLANE_WORKSPACE_SLUG=your-plane-workspace-slug
PLANE_WEBHOOK_SECRET=your-plane-webhook-secret
# Optional, defaults to Plane Cloud: PLANE_API_URL=https://api.plane.so and PLANE_APP_URL=https://app.plane.so
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Vercel Cron sends this as a bearer token to the Plane poll route
CRON_SECRET=your-cron-secret

# GitHub connector (GitHub App). The private key is the PEM on one line with literal \n.
GITHUB_APP_ID=5317132
GITHUB_APP_SLUG=axonteamapp
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Signs the state the GitHub and Slack install links carry. Any long random string.
CONNECTOR_STATE_SECRET=your-random-secret
# Encrypts stored Slack and Plane credentials (AES-256-GCM). Generate with `openssl rand -base64 32`.
CONNECTOR_ENCRYPTION_KEY=

# Slack app with distribution enabled. SLACK_SIGNING_SECRET above is this app's signing secret.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# App
API_PORT=8000
FRONTEND_URL=http://localhost:5173
