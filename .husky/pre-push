while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  [ "$branch" = "main" ] && continue
  if ! printf '%s' "$branch" | grep -Eq '^[a-z0-9-]+/[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo "Branch '$branch' must be named <github-username>/<feature> in lowercase kebab-case, e.g. volfiros/decision-inbox" >&2
    exit 1
  fi
done
